# VoiceGuard AI - .gitignore
# Prevents committing dependencies, secrets, and large model files to Git
# Add: node_modules/, __pycache__/, .env, *.pyc, .venv/, dist/, build/, trained_models/*.h5, .DS_Store

# Node
node_modules/
frontend/dist/

# Python
__pycache__/
*.pyc
.env
venv/
.env.*

# ML artifacts
ml-service/trained_models/*
!ml-service/trained_models/.gitkeep

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage / tests
.coverage
pytest_cache/

# Misc
.idea/
.vscode/
